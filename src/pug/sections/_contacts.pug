section.contacts#contacts 
	#map.contacts__map
	.container 
		.row 
			.col 
				.section-padding 
					.contacts__box 
						h6.contacts__title Для связи с нами
						.contacts__phones.phones 
							img.phones__icon(src="img/icon-telegram.png", alt="icon-telegram")
							img.phones__icon(src="img/icon-whatsapp.png", alt="icon-whatsapp")
							a.phones__num(href="tel:+74951234567") +7 (495) 123-45-67 
						a.contacts__email(href="mailto:info@website.ru") info@website.ru
						p.contacts__adress г. Москва, ул. Советская, д. 48. #[br] Химки, Московская обл., #[br] 143005 #[br] (ТЦ Химки Плаза)
